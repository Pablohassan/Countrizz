{
  "name": "countrizz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-basis.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-basis.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run --project unit",
    "test": "vitest run --project unit",
    "test:data": "vitest run --project data",
    "geodata:fetch": "tsx scripts/geodata/fetch-sources.ts",
    "geodata:capitals": "tsx scripts/geodata/fetch-capitals.ts",
    "geodata": "tsx scripts/geodata/build.ts",
    "textures:fetch": "tsx scripts/textures/fetch-textures.ts",
    "textures": "tsx scripts/textures/build-textures.ts",
    "e2e": "playwright test",
    "e2e:countries": "playwright test e2e/countries.spec.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "d3-interpolate": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@mapbox/geojson-rewind": "0.5.2",
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "3.1.1",
    "@types/d3-interpolate": "3.0.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "d3-geo": "3.1.1",
    "pngjs": "7.0.0",
    "polyclip-ts": "0.16.8",
    "polylabel": "2.1.0",
    "sharp": "0.35.5",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
